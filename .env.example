# Připojení k Postgres (na Vercelu ho nastaví integrace Neon automaticky)
DATABASE_URL=postgres://uzivatel:heslo@localhost:5432/mikiny

# Heslo do správy soutěže (/admin), alespoň 6 znaků
ADMIN_PASSWORD=zmente-me

# Úložiště souborů (na Vercelu ho nastaví integrace Blob automaticky).
# Lokálně ho můžete vynechat – soubory se pak ukládají do složky .data/uploads.
# BLOB_READ_WRITE_TOKEN=
